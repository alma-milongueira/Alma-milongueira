# ---------------------------------------------------------------
# Alma Milongueira — variáveis de ambiente
# Copie para .env.local (local) e cadastre as mesmas na Vercel.
# ---------------------------------------------------------------

# Supabase (Project Settings → API). Sem elas o app roda em "modo local":
# os projetos ficam só no aparelho (localStorage) e não há login.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# IA de texto (server-side, nunca vai pro navegador). Preencha UMA delas.
# Sem nenhuma, as sugestões saem só do motor de teoria musical.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Opcional: força o provedor quando as duas chaves existem (gemini | groq)
IA_PROVEDOR=

# Opcional: registra o service worker também no `npm run dev`
# NEXT_PUBLIC_SW_DEV=1
